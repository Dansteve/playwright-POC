# BlueOptima API Configuration
# Get your PAT from: My Profile -> Personal Access Token tab
BLUEOPTIMA_PAT=your_personal_access_token_here

# Fallback Authentication (Username/Password)
BLUEOPTIMA_USERNAME=your_email@example.com
BLUEOPTIMA_PASSWORD=your_password_here

# Proxy Settings (Found via 'netsh winhttp show proxy')
BLUEOPTIMA_HTTP_PROXY=http://appproxy-pnf.web.banksvcs.net:8080
BLUEOPTIMA_HTTPS_PROXY=http://appproxy-pnf.web.banksvcs.net:8080
